{
  "name": "save-the-dates",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25",
    "npm": ">=11.6.1 <12"
  },
  "packageManager": "npm@11.6.1",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:monitoring": "playwright test --config playwright.monitoring.config.ts",
    "test:release": "playwright test tests/account.spec.ts tests/dashboard.spec.ts tests/publication.spec.ts tests/themes.spec.ts tests/details.spec.ts tests/rsvp.spec.ts tests/payments.spec.ts tests/marketing.spec.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "smoke": "node scripts/smoke.mjs",
    "marketing:previews": "node scripts/capture-theme-previews.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "local:env": "node scripts/local-env.mjs",
    "local:demo-account": "node scripts/local-demo-account.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:persistence": "node scripts/verify-persistence.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "10.75.3",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "stripe": "22.6.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "supabase": "2.117.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
