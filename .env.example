# Run npm run local:env after npm run db:start to generate actual local values.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=your-local-publishable-key
# Server-only. Obtain it from the local CLI for development; never expose it to browser code.
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key
APP_ORIGIN=http://127.0.0.1:3000
# Docker uses SUPABASE_URL=http://host.docker.internal:54321.
# Stripe test-mode server credentials. Use `stripe listen` for the webhook secret.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Optional error tracking; nothing is sent when unset. See run-app-instructions.md.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=local
# APP_RELEASE=
